# Public links. Booking, demo video and ARI have no default: unset hides that CTA.
# Docs, GitHub and contact email fall back to the values below.
NEXT_PUBLIC_SITE_URL=https://www.vaultkit.io
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_DEMO_VIDEO_URL=
NEXT_PUBLIC_DOCS_URL=https://docs.vaultkit.io
NEXT_PUBLIC_GITHUB_URL=https://github.com/vaultkit-inc/vaultkitcli
NEXT_PUBLIC_ARI_URL=
NEXT_PUBLIC_CONTACT_EMAIL=founders@vaultkit.io

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
